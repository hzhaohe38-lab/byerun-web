{
    "version": 2,
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/static/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "/static/favicon.ico"
        },
        {
            "src": "/logo.png",
            "dest": "/static/logo.png"
        },
        {
            "src": "/",
            "dest": "/static/index.html"
        },
        {
            "src": "/api/auto-sign/?(.*)",
            "dest": "/server/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/api/proxy?path=$1"
        }
    ]
}
