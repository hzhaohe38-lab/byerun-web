{
    "version": 2,
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "static/**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "static/assets/$1"
        },
        {
            "src": "/favicon.ico",
            "dest": "static/favicon.ico"
        },
        {
            "src": "/logo.png",
            "dest": "static/logo.png"
        },
        {
            "src": "/",
            "dest": "static/index.html"
        },
        {
            "src": "/api/auto-sign/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "/api/proxy",
            "dest": "/api/proxy"
        },
        {
            "src": "/(.*)",
            "dest": "/api/proxy?path=$1"
        }
    ]
}
